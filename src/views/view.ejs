<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/css/main.css" />
    <title>view</title>
</head>
<body>
    <%- include( "components/header" ) %>
    <% for(let i = 0; i < files.length; i++){ %>
        <p>Name: <%= files[i].originalName %> | Type: <%= files[i].mimetype %></p>
      
        <% if(files[i].mimetype.startsWith('image/')) { %>
          <img src="/uploads/<%= files[i].storedName %>" alt="<%= files[i].originalName %>" width="300">
        <% } else if(files[i].mimetype.startsWith('video/')) { %>
          <video width="400" controls>
            <source src="/uploads/<%= files[i].storedName %>" type="<%= files[i].mimetype %>">
            Your browser does not support the video tag.
          </video>
        <% } else { %>
          <a href="/uploads/<%= files[i].storedName %>">Download <%= files[i].originalName %></a>
        <% } %>
      <% } %>
    <%- include( "components/footer" ) %>
</body>
</html>